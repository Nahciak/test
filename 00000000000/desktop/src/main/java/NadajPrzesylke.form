<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="NadajPrzesylke">
  <grid id="27dc6" binding="panelGlowny" layout-manager="GridBagLayout">
    <constraints>
      <xy x="20" y="20" width="560" height="320"/>
    </constraints>
    <properties/>
    <border type="none"/>
    <children>
      <grid id="a1b01" binding="panelRodzajPrzesylki" layout-manager="GridBagLayout">
        <constraints>
          <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="3" hsize-policy="3" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
          <gridbag top="8" left="8" bottom="4" right="8" weightx="0.0" weighty="0.0"/>
        </constraints>
        <properties/>
        <border type="etched" title="Rodzaj przesyłki"/>
        <children>
          <component id="a1b02" class="javax.swing.JRadioButton" binding="poleRadioPocztowka">
            <constraints>
              <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
              <gridbag top="0" left="4" bottom="0" right="40" weightx="1.0" weighty="0.0"/>
            </constraints>
            <properties>
              <selected value="true"/>
              <text value="Pocztówka"/>
            </properties>
          </component>
          <component id="a1b03" class="javax.swing.JRadioButton" binding="poleRadioList">
            <constraints>
              <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
              <gridbag top="0" left="4" bottom="0" right="40" weightx="1.0" weighty="0.0"/>
            </constraints>
            <properties>
              <text value="List"/>
            </properties>
          </component>
          <component id="a1b04" class="javax.swing.JRadioButton" binding="poleRadioPaczka">
            <constraints>
              <grid row="2" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
              <gridbag top="0" left="4" bottom="4" right="40" weightx="1.0" weighty="0.0"/>
            </constraints>
            <properties>
              <text value="Paczka"/>
            </properties>
          </component>
        </children>
      </grid>
      <component id="b2c01" class="javax.swing.JButton" binding="przyciskSprawdzCene">
        <constraints>
          <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
          <gridbag top="4" left="8" bottom="4" right="8" weightx="0.0" weighty="0.0"/>
        </constraints>
        <properties>
          <text value="Sprawdź Cenę"/>
        </properties>
      </component>
      <grid id="c3d01" binding="panelObrazCena" layout-manager="GridBagLayout">
        <constraints>
          <grid row="2" column="0" row-span="1" col-span="1" vsize-policy="3" hsize-policy="3" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
          <gridbag top="4" left="8" bottom="4" right="8" weightx="0.0" weighty="0.0"/>
        </constraints>
        <properties/>
        <border type="none"/>
        <children>
          <component id="c3d02" class="javax.swing.JLabel" binding="etykietaObrazu">
            <constraints>
              <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="0" fill="0" indent="0" use-parent-layout="false"/>
              <gridbag top="0" left="0" bottom="0" right="16" weightx="0.0" weighty="0.0"/>
            </constraints>
            <properties>
              <icon value="pocztowka.png"/>
              <text value=""/>
            </properties>
          </component>
          <component id="c3d03" class="javax.swing.JLabel" binding="etykietaCeny">
            <constraints>
              <grid row="0" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
              <gridbag top="0" left="0" bottom="0" right="0" weightx="0.0" weighty="0.0"/>
            </constraints>
            <properties>
              <font size="20" style="1"/>
              <text value="Cena: "/>
            </properties>
          </component>
        </children>
      </grid>
      <grid id="d4e01" binding="panelDaneAdresowe" layout-manager="GridBagLayout">
        <constraints>
          <grid row="0" column="1" row-span="3" col-span="1" vsize-policy="3" hsize-policy="3" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
          <gridbag top="8" left="8" bottom="4" right="8" weightx="1.0" weighty="0.0"/>
        </constraints>
        <properties/>
        <border type="etched" title="Dane adresowe"/>
        <children>
          <component id="d4e02" class="javax.swing.JLabel">
            <constraints>
              <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
              <gridbag top="2" left="8" bottom="2" right="8" weightx="0.0" weighty="0.0"/>
            </constraints>
            <properties>
              <labelFor value="d4e03"/>
              <text value="Ulica z numerem"/>
            </properties>
          </component>
          <component id="d4e03" class="javax.swing.JTextField" binding="poleUlica">
            <constraints>
              <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
              <gridbag top="2" left="8" bottom="6" right="8" weightx="1.0" weighty="0.0"/>
            </constraints>
            <properties>
              <columns value="20"/>
            </properties>
          </component>
          <component id="d4e04" class="javax.swing.JLabel">
            <constraints>
              <grid row="2" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
              <gridbag top="2" left="8" bottom="2" right="8" weightx="0.0" weighty="0.0"/>
            </constraints>
            <properties>
              <labelFor value="d4e05"/>
              <text value="Kod pocztowy"/>
            </properties>
          </component>
          <component id="d4e05" class="javax.swing.JTextField" binding="poleKodPocztowy">
            <constraints>
              <grid row="3" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
              <gridbag top="2" left="8" bottom="6" right="8" weightx="0.0" weighty="0.0"/>
            </constraints>
            <properties>
              <columns value="8"/>
            </properties>
          </component>
          <component id="d4e06" class="javax.swing.JLabel">
            <constraints>
              <grid row="4" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
              <gridbag top="2" left="8" bottom="2" right="8" weightx="0.0" weighty="0.0"/>
            </constraints>
            <properties>
              <labelFor value="d4e07"/>
              <text value="Miasto"/>
            </properties>
          </component>
          <component id="d4e07" class="javax.swing.JTextField" binding="poleMiasto">
            <constraints>
              <grid row="5" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
              <gridbag top="2" left="8" bottom="8" right="8" weightx="1.0" weighty="0.0"/>
            </constraints>
            <properties>
              <columns value="20"/>
            </properties>
          </component>
        </children>
      </grid>
      <component id="e5f01" class="javax.swing.JButton" binding="przyciskZatwierdz">
        <constraints>
          <grid row="3" column="0" row-span="1" col-span="2" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
          <gridbag top="4" left="8" bottom="8" right="8" weightx="0.0" weighty="0.0"/>
        </constraints>
        <properties>
          <text value="Zatwierdź"/>
        </properties>
      </component>
    </children>
  </grid>
  <buttonGroups>
    <group name="grupaRodzajuPrzesylki">
      <member id="a1b02"/>
      <member id="a1b03"/>
      <member id="a1b04"/>
